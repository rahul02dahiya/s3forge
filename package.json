{
  "name": "s3forge",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "pnpm -r --filter @s3forge/api --filter @s3forge/web build",
    "typecheck": "pnpm -r --filter @s3forge/api --filter @s3forge/web typecheck",
    "dev:api": "pnpm --filter @s3forge/api dev",
    "dev:web": "pnpm --filter @s3forge/web dev",
    "db:generate": "pnpm --filter @s3forge/database run generate",
    "db:migrate": "pnpm --filter @s3forge/database run migrate",
    "db:studio": "pnpm --filter @s3forge/database run studio",
    "test:smtp": "node scripts/test-smtp.js"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "typescript": "^5.9.2"
  }
}
