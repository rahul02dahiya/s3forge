# Server Environment Configuration
PORT=3000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here

# S3 Gateway & Credential Encryption
# Generate with: openssl rand -base64 32
S3FORGE_CREDENTIAL_ENCRYPTION_KEY=your_32_byte_base64_key_here
S3_GATEWAY_BASE_PATH=/s3
S3_GATEWAY_REGION=us-east-1

# PostgreSQL Connection & Authentication Secrets
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=s3forge
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_postgres_password_here

# MinIO / Object Storage Credentials & Endpoint
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=your_minio_password_here

# SMTP Credentials (Google App Password)
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_google_app_password
SMTP_FROM="S3Forge Support <your_gmail_address@gmail.com>"

# Domain & CORS Configuration (Production)
CORS_ORIGIN=https://your-domain.com
MINIO_BROWSER_REDIRECT_URL=https://admin.your-domain.com

